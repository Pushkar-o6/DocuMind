# DocuMind Environment Configuration
# Copy this file to .env and configure your desired settings

# ─── Provider Selection ───────────────────────────────────────────────
# "ollama"  → Local Ollama server (100% private, RTX 3050 CUDA acceleration)
# "gemini"  → Google Gemini Cloud (fast cloud fallback)
PROVIDER=ollama

# ─── Local Ollama ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_VLM_MODEL=moondream

# ─── Google Gemini Cloud ──────────────────────────────────────────────
# Obtain a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=models/gemini-embedding-001
GEMINI_LLM_MODEL=gemini-flash-lite-latest

# ─── Qdrant Vector Database ───────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documind

# ─── Retrieval & Reranker ─────────────────────────────────────────────
# Cross-encoder reranking (BGE-Reranker-Base) for top 5 high-precision candidates
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_MIN_SCORE=-4.0

# ─── OCR / Vision ─────────────────────────────────────────────────────
OCR_PROVIDER=tesseract

# ─── Ingestion & Advanced Chunking ────────────────────────────────────
CHUNKING_STRATEGY=structure_aware
CHUNK_QUERY_TYPE=factoid
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHUNK_MIN_TOKENS=150
MAX_PAGES=500

# ─── API ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── Paths ────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
